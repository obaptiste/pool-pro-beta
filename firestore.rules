rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: readings
    // Document ID: auto-generated
    // Fields:
    //   - id: string (required)
    //   - timestamp: timestamp (required)
    //   - uid: string (required)
    //   - chlorine: number | null (optional — null/missing means "not measured")
    //   - totalChlorine: number | null (optional — null/missing means "not measured")
    //   - ph: number | null (optional — null/missing means "not measured")
    //   - alkalinity: number | null (optional — null/missing means "not measured")
    //   - temperature: number | null (optional — null/missing means "not measured")
    //   - differentialPressure: number | null (optional — null/missing means "not measured")
    //   - calciumHardness: number | null (optional — null/missing means "not measured")
    //   - cyanuricAcid: number | null (optional — null/missing means "not measured")
    //   - notes: string (optional)
    //   - photoUrl: string (optional — Storage URL for evidence backing an
    //     MCP-submitted reading; only ever written by the MCP server via
    //     the Admin SDK, which bypasses these rules, but validated below
    //     anyway in case a client write ever carries it)
    //   - editedAt: timestamp (optional — set when the log is amended after creation)
    //   - previousValues: map (optional — field -> prior numeric value, from the last edit)
    //
    // Collection: tasks
    // Document ID: auto-generated
    // Fields:
    //   - id: string (required)
    //   - title: string (required, max 100 chars)
    //   - completed: bool (required)
    //   - priority: string (required, enum: low, medium, high, critical)
    //   - frequency: string (required, enum: daily, weekly, monthly, once)
    //   - isAI: bool (optional)
    //   - uid: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: inventory
    // Document ID: auto-generated
    // Fields:
    //   - id: string (required)
    //   - name: string (required, max 50 chars)
    //   - quantity: number (required)
    //   - unit: string (required, max 10 chars)
    //   - minThreshold: number (required)
    //   - concentrationPct: number (optional, 0 to 100 active-ingredient strength)
    //   - uid: string (required)
    //
    // Collection: equipment
    // Document ID: auto-generated
    // Fields:
    //   - id: string (required)
    //   - name: string (required, max 50 chars)
    //   - installDate: timestamp (required)
    //   - lastServiceDate: timestamp (optional)
    //   - serviceIntervalMonths: number (optional)
    //   - uid: string (required)
    //
    // Collection: schedules
    // Document ID: uid
    // Fields:
    //   - uid: string (required)
    //   - testFrequency: string (required, enum: daily, weekly, biweekly, monthly)
    //   - lastTestDate: timestamp (optional)
    //   - nextTestDate: timestamp (optional)
    //   - remindersEnabled: bool (required)
    //
    // Collection: controllerLogs
    // Document ID: "{uid}_{deviceId}_{YYYYMMDDTHHMMSS}" — deterministic
    //   (src/lib/hannaCsv.ts controllerLogDocId) so re-importing an export
    //   never duplicates a window; must start with the writer's uid. A local
    //   start time repeated when clocks go back gets a "_2" suffix.
    // Written by the controller CSV importer (ControllerImport.tsx).
    // Fields:
    //   - id: string (required, equals the document ID)
    //   - uid: string (required)
    //   - source: string (required, enum: hanna-csv)
    //   - deviceId: string (required, max 64 chars)
    //   - location: string | null (required, max 100 chars)
    //   - startLocal / endLocal: string (required, "YYYY-MM-DD HH:MM:SS")
    //   - start / end: timestamp (required)
    //   - phMin, phMax, orpMinMv, orpMaxMv, temperatureMinC, temperatureMaxC,
    //     acidBaseMinMl, acidBaseMaxMl, chlorineMinMl, chlorineMaxMl:
    //     number | null (required — null means "not reported")
    //   - importedAt: timestamp (required)
    //
    // Collection: poolControllerSyncState
    // Document ID: "{ownerUid}_{sourceId}" (e.g. "abc123_hanna-cloud")
    // Server-only — written exclusively by api/cron/sync-pool-controller.ts
    // via the Admin SDK (which bypasses these rules), tracking the last
    // pool-controller telemetry reading synced into `readings` so repeat
    // polls don't write duplicates. No client ever reads or writes it.
    // Fields:
    //   - lastReadingAt: timestamp (required)
    //   - updatedAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "orisjb@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isNumericOrNull(data, field) {
      return !(field in data) || data[field] == null || data[field] is number;
    }

    function isValidReading(data) {
      return hasRequiredFields(['id', 'timestamp', 'uid']) &&
             data.id is string &&
             data.timestamp is timestamp &&
             isNumericOrNull(data, 'chlorine') &&
             isNumericOrNull(data, 'totalChlorine') &&
             isNumericOrNull(data, 'ph') &&
             isNumericOrNull(data, 'alkalinity') &&
             isNumericOrNull(data, 'temperature') &&
             isNumericOrNull(data, 'differentialPressure') &&
             isNumericOrNull(data, 'calciumHardness') &&
             isNumericOrNull(data, 'cyanuricAcid') &&
             (!('editedAt' in data) || data.editedAt is timestamp) &&
             (!('previousValues' in data) || data.previousValues is map) &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             data.uid == request.auth.uid;
    }

    function isValidTask(data) {
      return hasRequiredFields(['id', 'title', 'completed', 'priority', 'frequency', 'uid', 'createdAt']) &&
             data.id is string &&
             data.title is string && data.title.size() <= 100 &&
             data.completed is bool &&
             data.priority in ['low', 'medium', 'high', 'critical'] &&
             data.frequency in ['daily', 'weekly', 'monthly', 'once'] &&
             data.uid == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidInventory(data) {
      return hasRequiredFields(['id', 'name', 'quantity', 'unit', 'minThreshold', 'uid']) &&
             data.id is string &&
             data.name is string && data.name.size() <= 50 &&
             data.quantity is number &&
             data.unit is string && data.unit.size() <= 10 &&
             data.minThreshold is number &&
             (!('concentrationPct' in data) ||
               (data.concentrationPct is number && data.concentrationPct > 0 && data.concentrationPct <= 100)) &&
             data.uid == request.auth.uid;
    }

    function isValidEquipment(data) {
      return hasRequiredFields(['id', 'name', 'installDate', 'uid']) &&
             data.id is string &&
             data.name is string && data.name.size() <= 50 &&
             data.installDate is timestamp &&
             data.uid == request.auth.uid;
    }

    function isValidWishlist(data) {
      return hasRequiredFields(['id', 'name', 'priority', 'quantity', 'purchaseOptions', 'uid', 'createdAt']) &&
             data.id is string &&
             data.name is string && data.name.size() <= 100 &&
             data.priority in ['low', 'medium', 'high', 'critical'] &&
             data.quantity is number &&
             data.purchaseOptions is list && data.purchaseOptions.size() <= 20 &&
             data.uid == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidSchedule(data) {
      return hasRequiredFields(['uid', 'testFrequency', 'remindersEnabled']) &&
             data.uid == request.auth.uid &&
             data.testFrequency in ['daily', 'weekly', 'biweekly', 'monthly'] &&
             data.remindersEnabled is bool;
    }

    function isNumberOrNull(data, field) {
      return data[field] == null || data[field] is number;
    }

    function isValidControllerLog(data, docId) {
      let fields = ['id', 'uid', 'source', 'deviceId', 'location', 'startLocal', 'endLocal', 'start', 'end',
                    'phMin', 'phMax', 'orpMinMv', 'orpMaxMv', 'temperatureMinC', 'temperatureMaxC',
                    'acidBaseMinMl', 'acidBaseMaxMl', 'chlorineMinMl', 'chlorineMaxMl', 'importedAt'];
      return hasRequiredFields(fields) && hasOnlyAllowedFields(fields) &&
             data.id == docId &&
             docId.matches(request.auth.uid + '_.+') &&
             data.uid == request.auth.uid &&
             data.source == 'hanna-csv' &&
             data.deviceId is string && data.deviceId.size() > 0 && data.deviceId.size() <= 64 &&
             (data.location == null || (data.location is string && data.location.size() <= 100)) &&
             data.startLocal is string && data.startLocal.size() == 19 &&
             data.endLocal is string && data.endLocal.size() == 19 &&
             data.start is timestamp && data.end is timestamp && data.end >= data.start &&
             isNumberOrNull(data, 'phMin') && isNumberOrNull(data, 'phMax') &&
             isNumberOrNull(data, 'orpMinMv') && isNumberOrNull(data, 'orpMaxMv') &&
             isNumberOrNull(data, 'temperatureMinC') && isNumberOrNull(data, 'temperatureMaxC') &&
             isNumberOrNull(data, 'acidBaseMinMl') && isNumberOrNull(data, 'acidBaseMaxMl') &&
             isNumberOrNull(data, 'chlorineMinMl') && isNumberOrNull(data, 'chlorineMaxMl') &&
             data.importedAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /readings/{readingId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidReading(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidReading(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /tasks/{taskId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidTask(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidTask(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /inventory/{itemId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidInventory(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidInventory(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /equipment/{equipmentId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidEquipment(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidEquipment(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /wishlist/{wishId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidWishlist(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidWishlist(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /schedules/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidSchedule(request.resource.data);
      allow update: if isOwner(uid) && isValidSchedule(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /controllerLogs/{logId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidControllerLog(request.resource.data, logId);
      allow update: if isDocOwner() && isValidControllerLog(request.resource.data, logId) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Server-only: the Admin SDK (used by api/cron/sync-pool-controller.ts)
    // bypasses these rules entirely, so this just makes explicit that no
    // client — not even the doc's own owner — reads or writes it directly.
    match /poolControllerSyncState/{docId} {
      allow read, write: if false;
    }
  }
}
